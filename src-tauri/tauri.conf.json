{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ScholarPulse",
  "version": "1.0.0",
  "identifier": "com.scholarpulse.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5000",
    "beforeDevCommand": "python server.py",
    "beforeBuildCommand": "node scripts/build-app.mjs --native --out dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScholarPulse — Academic Research Toolkit",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
